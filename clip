void kill_focus(absn_server *server, const absn_arg *arg)
{
    UNUSED(arg);
    if (!server->focused_toplevel) {
        return;
    }

    absn_toplevel *focus = server->focused_toplevel;

#ifdef XWAYLAND
    if (focus->type == TOPLEVEL_X11) {
        wlr_xwayland_surface_close(focus->xw);
    } else
#endif
    {
