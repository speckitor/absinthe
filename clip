    if (toplevel_is_unmanaged(toplevel)) {
        wlr_scene_node_set_position(&toplevel->scene_tree->node, event->x, event->y);
        wlr_xwayland_surface_configure(toplevel->xw, event->x, event->y, event->width, event->height);
        return;
    }
}

